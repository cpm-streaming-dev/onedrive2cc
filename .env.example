FLASK_SECRET_KEY=change-me-to-a-random-secret
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret
REDIRECT_URI=http://localhost:5000/auth/callback

# Tenant: consumers | organizations | common | <specific-tenant-id>
AZURE_TENANT=common

# OneDrive folder to watch (used for delta API)
# /me/drive/root = entire drive
# /me/drive/root:/POCONEDRIVE = specific folder
WATCH_RESOURCE=/me/drive/root:/POCONEDRIVE

# Confluent Cloud
KAFKA_BOOTSTRAP=pkc-xxxxx.region.cloud.confluent.cloud:9092
KAFKA_API_KEY=your-kafka-api-key
KAFKA_API_SECRET=your-kafka-api-secret
KAFKA_TOPIC=onedrive-files
